# 这些变量填在 Vercel 的项目设置里。这个文件只是清单，不要把真实的值写进仓库。

# ---- 必填 ----
# Clerk 应用的 Publishable key（不需要 Secret key）
CLERK_PUBLISHABLE_KEY=
# 站点的完整地址，结尾不带斜杠，例如 https://publish.example.com
LUMI_PUBLISH_ORIGIN=
# 至少 32 位的随机字符串：openssl rand -base64 48
LUMI_PUBLISH_SECRET=
# 连接私有 Blob 存储后由 Vercel 自动填入
BLOB_READ_WRITE_TOKEN=

# ---- 选填 ----
# 允许使用这个站点的 Clerk 编号（user_… 或 org_…），逗号分隔；不填 = 所有能登录的人
LUMI_PUBLISH_ALLOW=

# Instagram（“用 Instagram 登录”页面上显示的应用编号和密钥）
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook 主页（Meta 应用设置里的应用编号和密钥）
META_APP_ID=
META_APP_SECRET=
# YouTube（Google OAuth 客户端，类型为 Web 应用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Graph API 版本，默认 v27.0
META_GRAPH_VERSION=
