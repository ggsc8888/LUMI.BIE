{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/app.js": {
      "maxDuration": 180
    },
    "api/media.js": {
      "maxDuration": 120
    },
    "api/callback/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sign-in",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
